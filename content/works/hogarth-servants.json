        }
      },
      {
        "kind": "quote",
        "text": "It may have been hung in Hogarth's studio to demonstrate his ability as a portraitist to his patrons.",
        "source": {
          "author": "Wikipedia contributors",
          "title": "Hogarth's Servants",
