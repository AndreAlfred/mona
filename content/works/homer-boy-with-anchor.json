    "moment": [
      {
        "kind": "quote",
        "text": "In this work from a series of watercolors produced in Gloucester, MA, in the summer of 1873 Winslow Homer evokes the fraught nature of the local fishing industry by focusing not on the perilous work of adults, but rather the children they leave behind.",
        "source": {
          "author": "The Cleveland Museum of Art",
          "title": "Boy with Anchor",
          "publisher": "The Cleveland Museum of Art",
