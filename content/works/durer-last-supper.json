    "work": [
      {
        "kind": "quote",
        "text": "Albrecht Dürer made this version of the Last Supper after returning from Venice. He adopted the typically Italian horizontal format, long table, and disciples seated on the far side.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "The Last Supper",
          "readAt": "https://www.clevelandart.org/art/1966.9",
          "accessed": "2026-11-03",
