  "sections": {
    "work": [
      {
        "kind": "quote",
        "text": "The Sacred and Profane Love of the Borghese Gallery is one of the world's pictures, and beyond doubt the masterpiece of the early or Giorgionesque period.",
        "source": {
          "author": "Claude Phillips",
          "title": "The Earlier Work of Titian",
