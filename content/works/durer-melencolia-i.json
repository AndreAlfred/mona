  "sections": {
    "work": [
      {
        "kind": "quote",
        "text": "A crowning achievement of Albrecht Dürer’s engraved works, Melencolia I captivates the viewer with abundant variety.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "Melencolia I",
          "readAt": "https://www.clevelandart.org/art/1926.211",
          "accessed": "2026-11-03",
          "tier": 4,
          "publisher": "Cleveland Museum of Art",
          "license": "CC0"
        }
      }
    ],
    "moment": [
      {
        "kind": "quote",
        "text": "Melancholy, or sadness, was associated with introspective, creative minds, and here, Dürer personified it as an immobilized, winged figure, unable to use the tools scattered around her.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "Melencolia I",
          "readAt": "https://www.clevelandart.org/art/1926.211",
          "accessed": "2026-11-03",
          "tier": 4,
          "publisher": "Cleveland Museum of Art",
          "license": "CC0"
        }
      }
    ],
    "matters": [
      {
        "kind": "quote",
        "text": "A magic square whose numbers total 34 in all directions, an emaciated dog, an hourglass, and a ladder evoke time, order, suffering, life, and death.",
        "source": {
          "author": "Cleveland Museum of Art",
