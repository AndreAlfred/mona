    ],
    "moment": [
      {
        "kind": "quote",
        "text": "After World War I, Kollwitz’s work focused on the sorrows of those left behind: the children, widows, and mothers who underwent loss, physical neglect, and economic hardship.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "Pregnant Woman Contemplating Suicide (recto)",
          "publisher": "Cleveland Museum of Art",
          "readAt": "https://openaccess-api.clevelandart.org/api/artworks/138357",
          "accessed": "2026-11-05",
          "tier": 4,
          "license": "CC0"
        }
      }
    ],
    "matters": [
      {
        "kind": "quote",
        "text": "Her focus on grief and despair in this and other works emerged especially after her youngest son, Peter, was killed in the first months of the war.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "Pregnant Woman Contemplating Suicide (recto)",
