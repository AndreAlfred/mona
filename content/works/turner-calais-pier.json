  "sections": {
    "work": [
      {
        "kind": "quote",
        "text": "Calais Pier was based on Turner’s own observations; but his decision to paint it may have been stimulated by seeing, towards the end of his first trip abroad, Jacob van Ruisdael’s Une tempête sur le bord des Digues de la Hollande in the Louvre",
        "source": {
          "author": "Judy Egerton",
          "title": "The British Paintings: Calais Pier",
