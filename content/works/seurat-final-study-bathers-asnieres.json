    ],
    "moment": [
      {
        "kind": "quote",
        "text": "The frozen gestures and sedate poses of these bathers set a mood distinct from the sparkling scenes of Parisians enjoying restaurants and other riverbank activities favored by the Impressionists.",
        "source": {
          "author": "Art Institute of Chicago",
          "title": "Final Study for \"Bathers at Asnières\"",
          "publisher": "Art Institute of Chicago",
          "url": "https://www.artic.edu/artworks/20199",
