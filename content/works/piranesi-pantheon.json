          "page": "5"
        }
      }
    ],
    "matters": [
      {
        "kind": "quote",
        "text": "Among the other favourites of the etcher was the Pantheon. He etched in detail several plates of the Pantheon with the utmost care",
        "source": {
          "author": "Arthur M. Samuel",
          "title": "Piranesi",
          "publisher": "B. T. Batsford (Internet Archive scan)",
