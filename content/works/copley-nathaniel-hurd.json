        }
      }
    ],
    "moment": [
      {
        "kind": "quote",
        "text": "is recognized as the first American engraver and a silversmith in Boston, Massachusetts, in the 18th century.",
        "lead": "Nathaniel Hurd (1730–1777)",
        "source": {
