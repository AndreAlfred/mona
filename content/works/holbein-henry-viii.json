    ],
    "moment": [
      {
        "kind": "quote",
        "text": "By 1536, Holbein was employed as the King's Painter on an annual salary of 30 pounds—though he was never the highest-paid artist on the royal payroll.",
        "source": {
          "author": "Wikipedia contributors",
          "title": "Hans Holbein the Younger",
          "readAt": "https://en.wikipedia.org/wiki/Hans_Holbein_the_Younger",
