  "sections": {
    "work": [
      {
        "kind": "quote",
        "text": "The mind of the painter must resemble a mirror, which always takes the colour of the object it reflects and is completely occupied by the images of as many objects as are in front of it.",
        "lead": "Leonardo on what a painter must learn to see:",
        "source": {
          "author": "Leonardo da Vinci",
          "title": "The Notebooks of Leonardo da Vinci",
