        }
      }
    ],
    "moment": [
      {
        "kind": "quote",
        "text": "It is the second of only four surviving portraits of women painted by Leonardo, the others being Ginevra de' Benci, La Belle Ferronnière and the Mona Lisa.",
        "source": {
          "author": "Wikipedia contributors",
          "title": "Lady with an Ermine",
          "readAt": "https://en.wikipedia.org/wiki/Lady_with_an_Ermine",
