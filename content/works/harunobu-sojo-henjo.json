    "matters": [
      {
        "kind": "quote",
        "text": "Two young women are ginning cotton. One runs the machine that separates the seeds from the fibers, while the other stands by with a basket full of cotton.",
        "source": {
          "author": "Cleveland Museum of Art",
          "title": "Sōjō Henjō",
